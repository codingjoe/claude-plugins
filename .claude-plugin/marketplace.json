{
  "$schema": "https://code.claude.com/docs/en/plugin-marketplaces",
  "description": "CodingJoe's Claude Code marketplace — skills and MCP servers for esupgrade, VoIP, naming-things, reLint, SuperJoe, and Einfache Sprache.",
  "interface": {
    "displayName": "CodingJoe's Codex Marketplace"
  },
  "name": "codingjoe",
  "owner": {
    "email": "security@codingjoe.dev",
    "name": "Johannes Maron"
  },
  "plugins": [
    {
      "author": {
        "email": "security@codingjoe.dev",
        "name": "Johannes Maron"
      },
      "description": "Auto-upgrade JavaScript and TypeScript syntax to new ECMAScript features based on browser support.",
      "displayName": "esupgrade",
      "homepage": "https://github.com/codingjoe/esupgrade",
      "keywords": [
        "javascript",
        "ecmascript",
        "modernize",
        "upgrade",
        "codemod",
        "ast",
        "transform"
      ],
      "license": "BSD-2-Clause",
      "name": "esupgrade",
      "repository": "https://github.com/codingjoe/esupgrade",
      "source": {
        "source": "url",
        "url": "https://github.com/codingjoe/esupgrade"
      }
    },
    {
      "author": {
        "email": "security@codingjoe.dev",
        "name": "Johannes Maron"
      },
      "description": "Async VoIP library for the AI age. Ships an MCP server to make phone calls and (planned) skills.",
      "displayName": "VoIP",
      "homepage": "https://codingjoe.dev/VoIP/",
      "keywords": [
        "voip",
        "sip",
        "telephony",
        "voice",
        "webrtc",
        "mcp"
      ],
      "license": "BSD-2-Clause",
      "mcpServers": {
        "VoIP": {
          "args": [
            "voip[mcp]",
            "mcp"
          ],
          "command": "uvx",
          "env": {
            "SIP_AOR": "sip:USER:PASSWORD@example.com:5060?transport=tcp"
          },
          "type": "stdio"
        }
      },
      "name": "voip",
      "repository": "https://github.com/codingjoe/VoIP",
      "source": {
        "source": "url",
        "url": "https://github.com/codingjoe/VoIP"
      },
      "strict": false
    },
    {
      "author": {
        "email": "security@codingjoe.dev",
        "name": "Johannes Maron"
      },
      "description": "Naming conventions guidelines — solving computer science's second-hardest problem.",
      "displayName": "naming-things",
      "homepage": "https://github.com/codingjoe/naming-things",
      "keywords": [
        "conventions",
        "naming",
        "style"
      ],
      "license": "CC0-1.0",
      "name": "naming-things",
      "repository": "https://github.com/codingjoe/naming-things",
      "source": {
        "source": "url",
        "url": "https://github.com/codingjoe/naming-things"
      }
    },
    {
      "author": {
        "email": "security@codingjoe.dev",
        "name": "Johannes Maron"
      },
      "description": "Regular Expression Linter — write your own linting rules using regular expressions. Skills for running relint and authoring new rules.",
      "displayName": "reLint",
      "homepage": "https://github.com/codingjoe/relint",
      "keywords": [
        "linter",
        "regex",
        "linting",
        "rules"
      ],
      "license": "MIT",
      "name": "relint",
      "repository": "https://github.com/codingjoe/relint",
      "source": {
        "source": "url",
        "url": "https://github.com/codingjoe/relint"
      }
    },
    {
      "author": {
        "email": "security@codingjoe.dev",
        "name": "Johannes Maron"
      },
      "description": "SuperJoe — CodingJoe's digital clone following his coding guidelines and best practices.",
      "displayName": "SuperJoe",
      "homepage": "https://github.com/codingjoe/superjoe",
      "keywords": [
        "agent",
        "guidelines",
        "coding-standards"
      ],
      "license": "BSD-2-Clause",
      "name": "superjoe",
      "repository": "https://github.com/codingjoe/superjoe",
      "source": {
        "source": "url",
        "url": "https://github.com/codingjoe/superjoe"
      }
    },
    {
      "author": {
        "email": "security@codingjoe.dev",
        "name": "Johannes Maron"
      },
      "description": "Write and check German text in Einfache Sprache, plain language to DIN 8581-1. Short sentences, active voice, no officialese, every technical term explained. Ships a checker and a test suite. Refuses when Leichte Sprache is what the reader actually needs.",
      "displayName": "Einfache Sprache",
      "homepage": "https://github.com/codingjoe/einfache-sprache",
      "keywords": [
        "german",
        "plain-language",
        "einfache-sprache",
        "accessibility",
        "din-8581",
        "officialese",
        "barrierefreiheit"
      ],
      "license": "AGPL-3.0-or-later",
      "name": "einfache-sprache",
      "repository": "https://github.com/codingjoe/einfache-sprache",
      "source": {
        "source": "url",
        "url": "https://github.com/codingjoe/einfache-sprache"
      }
    }
  ]
}
